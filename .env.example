# Paths. Export these variables in the shell or load them in the systemd unit.
STEUERREPORT_V2_ROOT=/workspace/steuerreport-v2-plan
STEUERREPORT_V2_DB=/workspace/steuerreport-v2-plan/data/steuerreport_v2.duckdb
STEUERREPORT_USERTRANSFER_ROOT=/workspace/steuerreport/usertransfer

# Optional V2 connector credentials. Keep real values outside Git.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
HELIUS_API_KEY=
SOLSCAN_API_KEY=
ALCHEMY_API_KEY=

# Mobile connector setup and encrypted V2 secret storage.
# Point these variables at root-owned files; never store their contents in Git.
STEUERREPORT_V2_SECRET_VAULT_KEY_FILE=
STEUERREPORT_V2_REQUIRE_ENCRYPTED_SECRETS=false
STEUERREPORT_V2_CONNECTOR_SETUP_TOKEN_FILE=
STEUERREPORT_V2_PUBLIC_BASE_URL=

# Optional local AI integration.
LOCAL_LLM_BASE=http://127.0.0.1:11435/v1
LOCAL_LLM_MODEL=
OPENWEBUI_BASE_URL=http://127.0.0.1:8082
OPENWEBUI_API_TOKEN=
