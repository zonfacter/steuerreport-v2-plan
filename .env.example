# Paths. Export these variables in the shell or load them in the systemd unit.
# Keep paths absolute and private, outside the software repository.
# Defaults are sufficient for Docker; no operator accounts are preconfigured.
STEUERREPORT_V2_ROOT=
STEUERREPORT_V2_DB=
STEUERREPORT_USERTRANSFER_ROOT=

# Optional V2 connector credentials. Keep real values outside Git.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
HELIUS_API_KEY=
SOLSCAN_API_KEY=
ALCHEMY_API_KEY=

# Mobile connector setup and encrypted V2 secret storage.
# Private files must be readable by the service user; never store their contents in Git.
STEUERREPORT_V2_SECRET_VAULT_KEY_FILE=
STEUERREPORT_V2_REQUIRE_ENCRYPTED_SECRETS=true
# Unset: use the explicitly prepared private-state/keys/connector-setup.token.
# An explicitly empty value disables setup auth; it does not use the managed file.
# STEUERREPORT_V2_CONNECTOR_SETUP_TOKEN_FILE=/private/path/connector-setup.token
STEUERREPORT_V2_PUBLIC_BASE_URL=
# Optional private mobile document directory.
STEUERREPORT_V2_MOBILE_DOCUMENT_ROOT=

# Optional local AI integration.
LOCAL_LLM_BASE=http://127.0.0.1:11435/v1
LOCAL_LLM_MODEL=
OPENWEBUI_BASE_URL=http://127.0.0.1:8082
OPENWEBUI_API_TOKEN=
# Private operator data stays outside this repository.
STEUERREPORT_PRIVATE_PROFILE=
STEUERREPORT_PRIVATE_CONFIG_DIR=
STEUERREPORT_STATE_DIR=
# Bootstrap security settings, not mutable through the web UI.
STEUERREPORT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
STEUERREPORT_CORS_ORIGINS=
