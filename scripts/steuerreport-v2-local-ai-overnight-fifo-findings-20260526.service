[Unit]
Description=Steuerreport V2 local AI overnight FIFO findings analysis
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/steuerreport-v2-plan
Environment=PYTHONUNBUFFERED=1
Environment=LOCAL_LLM_BASE=http://192.168.2.203:11435/v1
Environment=LOCAL_LLM_MODEL=qwen3.6-35b-a3b-iq4xs
ExecStart=/usr/bin/python3 /workspace/steuerreport-v2-plan/scripts/run_local_ai_overnight_fifo_findings_20260526.py
TimeoutStartSec=16h
StandardOutput=append:/workspace/steuerreport-v2-plan/var/local_ai_prework/overnight_fifo_findings_systemd.log
StandardError=append:/workspace/steuerreport-v2-plan/var/local_ai_prework/overnight_fifo_findings_systemd.log

[Install]
WantedBy=multi-user.target
