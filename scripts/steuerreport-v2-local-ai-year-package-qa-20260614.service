[Unit]
Description=Steuerreport V2 local AI year evidence package QA
After=network-online.target steuerreport-v2-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/steuerreport-v2-plan
Environment=STEUERREPORT_V2_API=http://127.0.0.1:8010
Environment=LOCAL_LLM_BASE=http://192.168.2.155:11435/v1
Environment=LOCAL_LLM_MODEL=qwen3.6-35b-a3b-iq4xs-xt7900
ExecStart=/usr/bin/python3 /workspace/steuerreport-v2-plan/scripts/run_local_ai_year_package_qa_20260614.py
TimeoutStartSec=7200
StandardOutput=append:/workspace/steuerreport-v2-plan/var/local_ai_prework/year_package_qa_systemd.log
StandardError=append:/workspace/steuerreport-v2-plan/var/local_ai_prework/year_package_qa_systemd.log

[Install]
WantedBy=multi-user.target
