+            page.evaluate("document.activeElement?.blur(); document.querySelectorAll('textarea').forEach(e=>{e.scrollTop=0;e.scrollLeft=0}); window.scrollTo({top:0,behavior:'instant'})")
+            page.clock.run_for(50)
